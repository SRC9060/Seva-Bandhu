DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

# Brevo transactional email (recommended for Render Free).
# Use a Brevo API key and an email address verified in your Brevo account.
# In Render, set EMAIL_BACKEND=core.email_backends.BrevoEmailBackend explicitly.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Seva Bandhu
BREVO_API_TIMEOUT=15
DEFAULT_FROM_EMAIL=

# Optional legacy SMTP configuration (leave EMAIL_HOST blank to use console
# email locally when DEBUG=True and BREVO_API_KEY is not configured).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

DJANGO_CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# AI API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
